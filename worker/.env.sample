# ── Content (S3) ─────────────────────────────────────────────────────────────
# Content is pulled from an S3-compatible store (Floci/MinIO) into the writable
# volume CONTENT_DIR_S3. The worker no longer reads a filesystem mount.
CONTENT_DIR_S3=/data/content
AWS_ENDPOINT_URL=http://localhost.floci.io:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=

# ── Firebase ──────────────────────────────────────────────────────────────────
# Option A: Paste the entire service-account JSON as a single line
FIREBASE_CREDENTIALS_JSON=
# Option B: Leave blank and mount backend/app/core/credentials.json into the container

FIREBASE_PROJECT_ID=

# Path to credentials file inside the container (set by docker-compose volume mount)
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json

# ── Sync ──────────────────────────────────────────────────────────────────────
# How often to re-sync content-v2 to Firestore (seconds)
SYNC_INTERVAL_SECONDS=300
