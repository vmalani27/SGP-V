# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A: Paste the entire service-account JSON as a single line
FIREBASE_CREDENTIALS_JSON=
# Option B: Leave blank and mount backend/app/core/credentials.json into the container (docker-compose does this)

# Firebase project ID (used to initialize the Admin SDK)
FIREBASE_PROJECT_ID=

# ── Content Delivery ──────────────────────────────────────────────────────────
# Public base URL the client uses to download the published content tarball.
# The client fetches {base}/published/{version}/content.tar.gz directly from S3.
CONTENT_PUBLIC_BASE_URL=http://localhost.floci.io:4566/my-content-bucket

# ── Orchestrator Connection ──────────────────────────────────────────────────
# Host-reachable URL forwarded from the Vagrant VM (backend container → VM)
ORCHESTRATOR_URL=http://host.docker.internal:8001
# Internal orchestrator WebSocket URL (server-side only — the backend proxies
# the terminal WS to the browser and never leaks this address)
WS_ORCHESTRATOR_URL=ws://host.docker.internal:8001

# ── JWT ──────────────────────────────────────────────────────────────────────
# Shared secret for WebSocket auth tokens. MUST match orchestrator.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-in-production

# Token lifetime in minutes
JWT_EXPIRY_MINUTES=45
