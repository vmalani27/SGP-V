# ──────────────────────────────────────────────────────────────
# labops-docker-build — Building Images course lab & demo image
# ──────────────────────────────────────────────────────────────
# Extends labops-docker with pre-baked fixtures in /home/student
# and pre-configured environment for Building Images chapters & labs.
# Used by: docker-mastery (Module 2: Building Images)
#
# Build:
#   docker build -t labops-docker-build:latest -f Dockerfile.docker-build .
# ──────────────────────────────────────────────────────────────

ARG BASE_IMAGE=public.ecr.aws/i9t1l0m7/labops-docker:latest
FROM ${BASE_IMAGE}

# Ensure git, curl, and Node.js 20 are present for repository inspection & local testing in labs
RUN apt-get update -o Acquire::Retries=3 && apt-get install -y --no-install-recommends git curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update -o Acquire::Retries=3 && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Pre-populate chapter fixtures into /home/student
COPY fixtures/ /home/student/

# Initialize fixtures required for labs (git repo & bytecode for hello-app)
RUN mkdir -p /home/student/hello-app/__pycache__ \
    && touch /home/student/hello-app/__pycache__/app.cpython-312.pyc \
    && git -C /home/student/hello-app init -b main \
    && git -C /home/student/hello-app config user.name "Student" \
    && git -C /home/student/hello-app config user.email "student@labops.local" \
    && git -C /home/student/hello-app add . \
    && git -C /home/student/hello-app commit -m "Initial commit"

# Ensure student user owns all workspace files
RUN chown -R student:student /home/student \
    && chmod -R u+rwX /home/student

WORKDIR /home/student

# VOLUME for nested docker and containerd storage to prevent overlayfs-on-overlayfs EINVAL errors
VOLUME ["/var/lib/docker", "/var/lib/containerd"]

ENTRYPOINT ["/sbin/init"]
