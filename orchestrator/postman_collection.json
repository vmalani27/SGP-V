{
  "info": {
    "name": "SGP Orchestrator (LabOps) API",
    "description": "Test suite for the LabOps orchestrator direct API — the endpoints the frontend calls today (lab lifecycle, validation exec, inspect). The backend is NOT involved in lab traffic (its /api/v1/labs* and /api/v1/demos* proxy routers were removed).\n\nAUTH: all lab/demo/schema routes require `Authorization: Bearer <ORCHESTRATOR_SECRET>` (collection-level auth uses {{orchestratorSecret}}, default `local-dev-super-secret`). Health is public. The terminal WebSocket auth is a first-message token (`{\"type\":\"auth\",\"token\":<secret>}` on ws://localhost:8001/ws/terminal) — not covered by Postman requests.\n\n⚠️ These requests provision real Docker containers on the orchestrator host (docker.sock). Clean up stale containers with: docker ps --filter label=labops-lab --format '{{.ID}}' | xargs -r docker rm -f",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{orchestratorSecret}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "orchestratorUrl",
      "value": "http://localhost:8001"
    },
    {
      "key": "orchestratorSecret",
      "value": "local-dev-super-secret"
    },
    {
      "key": "sessionId",
      "value": ""
    },
    {
      "key": "gitSessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Health endpoints are public (no secret required).",
      "item": [
        {
          "name": "GET /health (orchestrator)",
          "request": {
            "method": "GET",
            "url": "{{orchestratorUrl}}/health",
            "description": "Orchestrator health check — the frontend's lab path target"
          },
          "response": []
        },
        {
          "name": "GET /health (backend)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8000/health",
            "description": "Backend health check (metadata/progress service)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Lab Lifecycle (direct)",
      "description": "Start, manage, and destroy lab containers. These are the endpoints the frontend calls directly — the backend is not involved.",
      "item": [
        {
          "name": "Start Docker Lab",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status is running', () => {",
                  "    pm.expect(json.status).to.eql('running');",
                  "});",
                  "pm.test('Has session_id', () => {",
                  "    pm.expect(json).to.have.property('session_id');",
                  "});",
                  "pm.test('Has lab_id', () => {",
                  "    pm.expect(json).to.have.property('lab_id');",
                  "    pm.expect(json.lab_id).to.eql('lab-1');",
                  "});",
                  "pm.collectionVariables.set('sessionId', json.session_id);",
                  "console.log('Session ID: ' + json.session_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"postman\", \"lab_id\": \"lab-1\", \"image\": \"labops-docker:latest\", \"apt_packages\": [], \"pre_pull\": [\"nginx:alpine\", \"alpine:latest\"], \"setup\": []}"
            },
            "description": "Start a Docker lab. The client supplies the env config (image, apt_packages, pre_pull, setup) — the orchestrator never reads lab.yaml."
          },
          "response": []
        },
        {
          "name": "Start Git Lab",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status is running', () => {",
                  "    pm.expect(json.status).to.eql('running');",
                  "});",
                  "pm.collectionVariables.set('gitSessionId', json.session_id);",
                  "console.log('Git Session ID: ' + json.session_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user_id\": \"postman\", \"lab_id\": \"lab-1\", \"image\": \"labops-ubuntu:latest\", \"apt_packages\": [], \"pre_pull\": [], \"setup\": []}"
            },
            "description": "Start a Git/Ubuntu lab with a minimal env config."
          },
          "response": []
        },
        {
          "name": "Recover session — /labs/by_key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Recovers a live session from Docker labels', () => {",
                  "    pm.expect(json).to.have.property('session_id');",
                  "    pm.expect(json.status).to.eql('running');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{orchestratorUrl}}/labs/by_key?user_id=postman&lab_id=lab-1",
            "description": "Recover the live container for a user+lab by Docker labels, or 404. This replaces the removed backend 'active' check."
          },
          "response": []
        },
        {
          "name": "Get Session Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returns session with required fields', () => {",
                  "    pm.expect(json).to.have.property('session_id');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('lab_id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}",
            "description": "Get session status directly from the orchestrator."
          },
          "response": []
        },
        {
          "name": "Stop Lab",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status is stopped', () => {",
                  "    pm.expect(json.status).to.eql('stopped');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/stop",
            "header": [],
            "description": "Stop (pause) a lab container."
          },
          "response": []
        },
        {
          "name": "Resume Lab",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Status is running', () => {",
                  "    pm.expect(json.status).to.eql('running');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/resume",
            "header": [],
            "description": "Resume a stopped lab container."
          },
          "response": []
        },
        {
          "name": "Destroy Lab",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returns destroyed message', () => {",
                  "    pm.expect(json.detail).to.include('destroyed');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}",
            "header": [],
            "description": "Destroy (force-remove) a lab container."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Command Execution (direct)",
      "description": "Run commands inside lab containers. This is the frontend's validation exec — the client picks the command + user (from task.validation).",
      "item": [
        {
          "name": "Exec — whoami",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returns output', () => {",
                  "    pm.expect(json).to.have.property('output');",
                  "});",
                  "pm.test('Exit code is 0', () => {",
                  "    pm.expect(json.exit_code).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/exec",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"command\": \"whoami\", \"user\": \"student\"}"
            },
            "description": "Run whoami as student"
          },
          "response": []
        },
        {
          "name": "Exec — docker images",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returns output', () => {",
                  "    pm.expect(json).to.have.property('output');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/exec",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"command\": \"docker images -q | wc -l\", \"user\": \"student\"}"
            },
            "description": "Count local Docker images"
          },
          "response": []
        },
        {
          "name": "Exec — as root",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returns output', () => {",
                  "    pm.expect(json).to.have.property('output');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/exec",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"command\": \"whoami\", \"user\": \"root\"}"
            },
            "description": "Run command as root (honors validation.execution_user)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Testing & Debug",
      "description": "Additional orchestrator endpoints useful when debugging the lab stack.",
      "item": [
        {
          "name": "List Labs",
          "request": {
            "method": "GET",
            "url": "{{orchestratorUrl}}/labs",
            "header": [],
            "description": "List all lab containers managed by the orchestrator (running and stopped)."
          },
          "response": []
        },
        {
          "name": "Inspect",
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/inspect",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"path\": \"/etc/passwd\", \"check\": \"exists\"}"
            },
            "description": "Check if a file exists / read it (file_check-style probes run by the frontend)."
          },
          "response": []
        },
        {
          "name": "Validate (legacy)",
          "request": {
            "method": "POST",
            "url": "{{orchestratorUrl}}/labs/{{sessionId}}/validate",
            "header": [],
            "description": "Legacy validator — the frontend no longer calls this; validation is client-side via exec."
          },
          "response": []
        },
        {
          "name": "Get JSON Schema",
          "request": {
            "method": "GET",
            "url": "{{orchestratorUrl}}/schemas/yaml",
            "header": [],
            "description": "Lab YAML JSON Schema"
          },
          "response": []
        },
        {
          "name": "Get Sample YAML",
          "request": {
            "method": "GET",
            "url": "{{orchestratorUrl}}/schemas/sample",
            "header": [],
            "description": "Sample lab YAML file"
          },
          "response": []
        }
      ]
    }
  ]
}