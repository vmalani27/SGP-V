# ────────────────────────────────────────────────────────────────────────────────
# Orchestrator Environment Configuration Sample (.env.sample)
#
# Copy this file to .env or load it into your environment when running the
# orchestrator service locally or inside a VM.
# ────────────────────────────────────────────────────────────────────────────────

# ── Docker Daemon Connection ──────────────────────────────────────────────────
# Path to the Docker daemon socket or named pipe.
#
# Options:
#   - Linux / Vagrant VM (default):
#       DOCKER_HOST=unix:///var/run/docker.sock
#   - Windows Host (Docker Desktop):
#       DOCKER_HOST=npipe:////./pipe/docker_engine
#   - TCP Socket / Remote Engine:
#       DOCKER_HOST=tcp://127.0.0.1:2375
DOCKER_HOST=unix:///var/run/docker.sock

# ── Container Runtime Mode ────────────────────────────────────────────────────
# Defines the security and runtime backend used when creating lab containers.
#
# Options:
#   - sysbox (default):
#       Uses the Sysbox runtime (sysbox-runc) for secure, unprivileged Docker-in-Docker.
#       Requires Sysbox installed (used inside the Vagrant VM / Linux host).
#   - standard | privileged | dev:
#       Uses standard Docker runc with `privileged=True`.
#       Enables running Docker-in-Docker on Docker Desktop (Windows / macOS) without Sysbox.
CONTAINER_RUNTIME_MODE=sysbox

# ── Security & Authentication ─────────────────────────────────────────────────
# Shared secret for authenticating WebSocket terminal sessions and API requests.
# Must match NEXT_PUBLIC_ORCHESTRATOR_SECRET in the frontend.
ORCHESTRATOR_SECRET=local-dev-super-secret

# Secret key used for minting/verifying JWT auth tokens
JWT_SECRET=dev-only-change-in-production

# Tolerated clock skew (seconds) between token issuer (backend) and orchestrator
JWT_LEEWAY_SECONDS=30

# ── Container Naming & Limits ─────────────────────────────────────────────────
# Prefix assigned to active lab container names
LAB_PREFIX=labops-lab

# Prefix assigned to interactive demo container names
DEMO_PREFIX=labops-demo

# Maximum number of concurrent lab/demo containers allowed per user/machine.
# When exceeded, oldest inactive containers are auto-evicted to conserve RAM.
MAX_CONCURRENT_LABS=1

# ── Session Timeouts ──────────────────────────────────────────────────────────
# Inactivity/lifecycle timeout in minutes before a lab container is automatically stopped
LAB_TIMEOUT_MINUTES=40

# Inactivity/lifecycle timeout in minutes before a demo container is automatically stopped
DEMO_TIMEOUT_MINUTES=30
