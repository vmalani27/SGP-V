# ── Docker ────────────────────────────────────────────────────────────────────
DOCKER_HOST=unix:///var/run/docker.sock

# Prefix for container names (e.g. sgp-lab-abc123)
LAB_PREFIX=sgp-lab

# Auto-destroy containers after this many minutes of inactivity
LAB_TIMEOUT_MINUTES=40

# ── JWT ──────────────────────────────────────────────────────────────────────
# Shared secret for WebSocket auth tokens. MUST match backend.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-only-change-in-production
