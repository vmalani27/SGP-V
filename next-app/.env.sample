# ── Orchestrator Configuration ───────────────────────────────────────────────
# Client-side / Nginx reverse proxy URL for WebSocket terminal and lab lifecycle
# Server-side internal network URL (in docker compose network)
NEXT_PUBLIC_ORCHESTRATOR_SECRET=local-dev-super-secret

# ── Local Storage Paths ──────────────────────────────────────────────────────
USER_DATA_DIR=/app/.user_data
CONTENT_LOCAL_DIR=/app/.content
